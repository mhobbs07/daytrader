# Rust
# Cargo.lock is committed: this workspace ships binaries, so builds must be reproducible.
**/target/
**/*.rs.bk
*.pdb

# Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# .sqlx/ is committed: it is the sqlx offline query cache the build compiles against.

# Logs
*.log
logs/
data/logs/

# Configuration (contains API keys)
config/local.toml
config/production.toml
.env
.env.local

# Data directory (except default config) — anchored to repo root so src/data/ is NOT ignored
/data/
!/data/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude Code worktrees (local development only)
.claude/worktrees/

# MCP server configs — per-user (contain machine-specific absolute paths)
.mcp.json
.kilocode/mcp.json

# OS
Thumbs.db

# Test artifacts
/coverage/
*.profraw
*.profdata

# Verification reports (generated by scripts/verify_agent_work.sh)
reports/verification/

# Benchmarks (covered by **/target/ above)

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
env/

# Node (Tauri frontend + MCP servers)
**/node_modules/
**/dist/
dist-ssr/
*.local
