# Copy to .env and adjust. Do NOT commit .env (it is gitignored).

# sqlx compile-time macros build from the committed offline cache in .sqlx/,
# so no database is needed to compile. Keep this true.
SQLX_OFFLINE=true

# Only needed to regenerate or check the offline cache after changing a query
# (cargo sqlx prepare -- --lib --tests). scripts/setup_db.sh creates this file.
DATABASE_URL=sqlite:data/db/daytrader.db

# Alpaca paper-trading credentials (only needed for examples/ and future live modes;
# the desktop app runs on synthetic mock data without them).
# ALPACA_API_KEY=your_api_key
# ALPACA_API_SECRET=your_api_secret

# MCP server secrets (used by scripts/mcp-env-wrapper.sh)
# Get a key at https://brave.com/search/api
# BRAVE_API_KEY=your_brave_api_key
